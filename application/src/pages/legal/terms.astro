---
import LegalLayout from '../../layouts/LegalLayout.astro';
import site from '../../../site.config.mjs';
const host = new URL(site.url).host;
---
<LegalLayout title="Terms of use" description={`Terms for using ${host}.`}>
  <p>By using {host} you agree to these terms. If you don’t agree, please don’t use the site.</p>

  <h2>Use of the site</h2>
  <p>You may browse the site for personal, non-commercial purposes. Please don’t attempt to disrupt it, overload it, or access it by automated means that circumvent its normal operation.</p>

  <h2>Intellectual property</h2>
  <p>All content is owned by {site.legal.owner} and protected by copyright. Use of it is governed by the <a href="/legal/copyright">copyright &amp; licensing</a> page.</p>

  <h2>No warranty</h2>
  <p>The site is provided “as is”. I try to keep it accurate and available but make no promise that it will be uninterrupted or error-free, and I’m not liable for any loss arising from its use, to the extent the law allows.</p>

  <h2>Links</h2>
  <p>Links to other sites are provided for convenience. I don’t control those sites and am not responsible for them.</p>

  <h2>Changes</h2>
  <p>I may update these terms or the site at any time. The date at the top of the page shows the latest revision.</p>

  <h2>Governing law</h2>
  <p>These terms are governed by the laws of {site.legal.jurisdiction}, without regard to conflict-of-law rules.</p>

  <h2>Contact</h2>
  <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
</LegalLayout>
