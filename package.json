{
  "name": "photography-site",
  "private": true,
  "engines": { "node": ">=20.12", "pnpm": ">=9" },
  "scripts": {
    "dev": "pnpm --filter application dev",
    "build": "pnpm --filter application build",
    "preview": "pnpm --filter application preview",
    "deploy:site": "pnpm --filter application deploy:site",
    "check": "pnpm --filter application check",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter application test:e2e",
    "content": "node server/src/cli.js"
  }
}
