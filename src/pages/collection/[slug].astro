---
import Base from '../../layouts/Base.astro';
import data from '../../data/index.json';
export function getStaticPaths() {
  return data.collections.map((c, i) => ({ params: { slug: c.slug }, props: { c, n: i + 1 } }));
}
const { c, n } = Astro.props;
const pad = (x) => String(x).padStart(2, '0');
---
<Base title={c.title}>
  <main class="page" id="coll" data-images={JSON.stringify(c.images.map((i) => i.full))}>
    <div class="side mono">{c.description} {c.year}.</div>
    <div class="stage">
      <div class="title mono">[{pad(n)}]<br />{c.title}<br /><span>[{c.film}]</span></div>
      <div class="frame"><img id="hero" src={c.images[0].full} alt={c.images[0].alt} transition:name={`cover-${c.slug}`} /></div>
      <div class="pn mono"><button id="prev">← Previous</button><button id="next">Next →</button></div>
    </div>
    <div class="thumbs">
      {c.images.map((im, i) => <img data-i={i} src={im.thumb} alt="" class={i === 0 ? 'cur' : ''} />)}
    </div>
    <a class="back mono" href="/">← Close</a>
    <div class="count mono" id="count">01 / {pad(c.images.length)}</div>
  </main>
</Base>
<script>
  let idx = 0;
  const q = (s: string) => document.querySelector<HTMLElement>(s)!;
  function go(i: number) {
    const root = q('#coll'); if (!root) return;
    const imgs: string[] = JSON.parse(root.dataset.images!);
    idx = (i + imgs.length) % imgs.length;
    const h = q('#hero') as HTMLImageElement;
    h.classList.add('sw');
    setTimeout(() => {
      h.src = imgs[idx]; h.classList.remove('sw');
      document.querySelectorAll('.thumbs img').forEach((t, k) => t.classList.toggle('cur', k === idx));
      q('#count').textContent = `${String(idx + 1).padStart(2, '0')} / ${String(imgs.length).padStart(2, '0')}`;
    }, 350);
  }
  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('coll')) return;
    idx = 0;
    q('#prev').onclick = () => go(idx - 1);
    q('#next').onclick = () => go(idx + 1);
    document.querySelectorAll<HTMLElement>('.thumbs img').forEach((t) => (t.onclick = () => go(+t.dataset.i!)));
  });
  document.addEventListener('keydown', (e) => {
    if (!document.getElementById('coll')) return;
    if (e.key === 'ArrowRight') go(idx + 1);
    if (e.key === 'ArrowLeft') go(idx - 1);
    if (e.key === 'Escape') history.back();
  });
</script>
