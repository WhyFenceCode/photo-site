---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import site from '../site.js';
const { title = `${site.name} — Photography`, bar = true, cur = '' } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono&display=swap" rel="stylesheet" />
  <ClientRouter />
</head>
<body>
  {bar && (
    <header class="bar mono">
      <a href="/">{site.name}</a>
      <nav><a href="/" class={cur === 'home' ? 'cur' : ''}>Home</a><a href="/library/" class={cur === 'library' ? 'cur' : ''}>Library</a></nav>
      <a href={`mailto:${site.email}`}>Contact</a>
    </header>
  )}
  <slot />
</body>
</html>
